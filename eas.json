{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios":     { "simulator": false }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "ios":     { "buildConfiguration": "Release" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "o.moena.salgado@gmail.com",
        "ascAppId": "REEMPLAZAR_CON_TU_APP_ID",
        "appleTeamId": "REEMPLAZAR_CON_TU_TEAM_ID"
      }
    }
  }
}
